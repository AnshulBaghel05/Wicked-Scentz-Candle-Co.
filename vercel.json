{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/((?!assets/|images/|favicon.*|apple-touch-icon.*|android-chrome.*|site\\.webmanifest).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(favicon\\..*|apple-touch-icon\\.png|android-chrome-.*|site\\.webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
